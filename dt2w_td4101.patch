+/*
+ * Double tap to wake (experimental, software detection).
+ *
+ * When the screen goes off we normally power the touch IC down. With dt2w
+ * enabled we instead leave the IC running, make its IRQ a wake source and
+ * look for two short taps close together in the finger data. On a hit we
+ * send a wake key; the usual FB unblank path then runs input_open().
+ *
+ * Runtime switch: /sys/module/synaptics_i2c_rmi/parameters/dt2w (0/1)
+ */
+#define DT2W_MAX_TAP_MS		300	/* max finger-down time of one tap */
+#define DT2W_MAX_GAP_MS		400	/* max time between the two taps */
+#define DT2W_MAX_DIST		100	/* max travel / tap spacing, in px */
+
+static bool dt2w_enable = true;
+module_param_named(dt2w, dt2w_enable, bool, 0644);
+MODULE_PARM_DESC(dt2w, "Double tap to wake (1=on, 0=off)");
+
+static int dt2w_key = KEY_WAKEUP;
+module_param_named(dt2w_key, dt2w_key, int, 0644);
+MODULE_PARM_DESC(dt2w_key, "Key sent on double tap (143=KEY_WAKEUP, 116=KEY_POWER)");
+
+static bool dt2w_near(int x0, int y0, int x1, int y1)
+{
+	int dx = x0 - x1;
+	int dy = y0 - y1;
+
+	return (dx * dx + dy * dy) <= (DT2W_MAX_DIST * DT2W_MAX_DIST);
+}
+
+static void synaptics_rmi4_dt2w_process(struct synaptics_rmi4_data *rmi4_data,
+		unsigned char touch_count)
+{
+	unsigned long now = jiffies;
+	int ii;
+	int x = 0;
+	int y = 0;
+
+	if (!rmi4_data->dt2w_active)
+		return;
+
+	if (touch_count > 1) {
+		/* more than one finger is never a wake gesture */
+		rmi4_data->dt2w_finger_down = false;
+		rmi4_data->dt2w_last_tap = 0;
+		return;
+	}
+
+	if (touch_count == 1) {
+		for (ii = 0; ii < MAX_NUMBER_OF_FINGERS; ii++) {
+			if (rmi4_data->finger[ii].state) {
+				x = rmi4_data->finger[ii].x;
+				y = rmi4_data->finger[ii].y;
+				break;
+			}
+		}
+
+		if (!rmi4_data->dt2w_finger_down) {
+			rmi4_data->dt2w_finger_down = true;
+			rmi4_data->dt2w_moved = false;
+			rmi4_data->dt2w_down_x = x;
+			rmi4_data->dt2w_down_y = y;
+			rmi4_data->dt2w_down_time = now;
+		} else if (!dt2w_near(x, y, rmi4_data->dt2w_down_x,
+				rmi4_data->dt2w_down_y)) {
+			rmi4_data->dt2w_moved = true;
+		}
+		return;
+	}
+
+	/* touch_count == 0: finger lifted */
+	if (!rmi4_data->dt2w_finger_down)
+		return;
+	rmi4_data->dt2w_finger_down = false;
+
+	if (rmi4_data->dt2w_moved ||
+	    time_after(now, rmi4_data->dt2w_down_time +
+			msecs_to_jiffies(DT2W_MAX_TAP_MS))) {
+		rmi4_data->dt2w_last_tap = 0;
+		return;
+	}
+
+	if (rmi4_data->dt2w_last_tap &&
+	    time_before(now, rmi4_data->dt2w_last_tap +
+			msecs_to_jiffies(DT2W_MAX_GAP_MS)) &&
+	    dt2w_near(rmi4_data->dt2w_down_x, rmi4_data->dt2w_down_y,
+			rmi4_data->dt2w_last_x, rmi4_data->dt2w_last_y)) {
+		input_info(true, &rmi4_data->i2c_client->dev,
+				"%s: double tap detected, sending key %d\n",
+				__func__, dt2w_key);
+		rmi4_data->dt2w_last_tap = 0;
+		input_report_key(rmi4_data->input_dev, dt2w_key, 1);
+		input_sync(rmi4_data->input_dev);
+		input_report_key(rmi4_data->input_dev, dt2w_key, 0);
+		input_sync(rmi4_data->input_dev);
+		return;
+	}
+
+	rmi4_data->dt2w_last_tap = now;
+	rmi4_data->dt2w_last_x = rmi4_data->dt2w_down_x;
+	rmi4_data->dt2w_last_y = rmi4_data->dt2w_down_y;
+}
+
+/* returns true if the IC was left running (caller must not power it down) */
+static bool synaptics_rmi4_dt2w_enter(struct synaptics_rmi4_data *rmi4_data)
+{
+	if (!dt2w_enable || rmi4_data->dt2w_active ||
+	    rmi4_data->touch_stopped || rmi4_data->doing_reflash ||
+	    !rmi4_data->irq_enabled)
+		return false;
+
+	synpatics_rmi4_release_all_event(rmi4_data, RELEASE_TYPE_ALL);
+	rmi4_data->dt2w_finger_down = false;
+	rmi4_data->dt2w_moved = false;
+	rmi4_data->dt2w_last_tap = 0;
+	rmi4_data->dt2w_active = true;
+	enable_irq_wake(rmi4_data->irq);
+
+	input_info(true, &rmi4_data->i2c_client->dev,
+			"%s: screen off, IC kept awake for double tap\n", __func__);
+	return true;
+}
+
+/* returns true if we were in dt2w mode (IC was never powered down) */
+static bool synaptics_rmi4_dt2w_exit(struct synaptics_rmi4_data *rmi4_data)
+{
+	if (!rmi4_data->dt2w_active)
+		return false;
+
+	disable_irq_wake(rmi4_data->irq);
+	rmi4_data->dt2w_active = false;
+	rmi4_data->dt2w_finger_down = false;
+
+	input_info(true, &rmi4_data->i2c_client->dev,
+			"%s: leaving dt2w mode\n", __func__);
+	return true;
+}
+
