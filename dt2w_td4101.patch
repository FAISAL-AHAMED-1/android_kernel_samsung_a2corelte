 	input_set_abs_params(rmi4_data->input_dev,
 			ABS_MT_POSITION_X, 0,
@@ -4362,6 +4504,15 @@
 
 	input_dbg(false, &rmi4_data->i2c_client->dev, "%s\n", __func__);
 
+	if (synaptics_rmi4_dt2w_exit(rmi4_data)) {
